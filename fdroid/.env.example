# ===========================================================================
#  F-Droid repository configuration
#  Copy this file to ".env", fill it in, then run: docker compose up -d
# ===========================================================================

# --- Where to publish -------------------------------------------------------
# "web" starts a local web server on this host, with automatic HTTPS.
# Make this empty to publish to S3 only. See the S3 section below.
COMPOSE_PROFILES=web

# The public address of the repository, with no path at the end.
# The repository becomes <FDROID_BASE_URL>/fdroid/repo
#   Local web server : https://apps.example.com
#   AWS S3 bucket    : https://my-bucket.s3.eu-west-1.amazonaws.com
#   CloudFront / CDN : https://d111111abcdef8.cloudfront.net
FDROID_BASE_URL=https://apps.example.com

# --- Local web server (only used when COMPOSE_PROFILES contains "web") ------
# Use a domain name for automatic HTTPS: apps.example.com
# Use :80 for plain HTTP behind your own reverse proxy.
FDROID_SITE_ADDRESS=apps.example.com
FDROID_HTTP_PORT=80
FDROID_HTTPS_PORT=443

# --- S3 (optional) ----------------------------------------------------------
# Give a bucket name to send the repository to S3 after each index.
# The files go to <bucket>/fdroid/repo/
# Caution: this is a mirror operation. It removes the files in the bucket
# that are not in data/repo/.
FDROID_S3_BUCKET=

# For AWS S3 in the us-east-1 region, these two values are sufficient.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For a different AWS region, or for MinIO, Cloudflare R2, Backblaze B2 or
# Wasabi, make the file "data/rclone.conf" and put the section name here.
# Section 10 of FDROID.md gives an example.
FDROID_RCLONE_REMOTE=

# --- Pull from CI (optional) ------------------------------------------------
# The GitHub Actions job puts each new APK file in <bucket>/apks/.
# Give that prefix here to copy those files into data/repo/ automatically.
# The indexer then signs them and the users get the update.
# An empty value turns the pull off. This step only copies; it never deletes
# a local file.
FDROID_S3_PULL_PREFIX=apks

# --- Repository details -----------------------------------------------------
FDROID_REPO_NAME=My F-Droid Repo
FDROID_REPO_DESCRIPTION=Internal Android apps for my organisation.

# Optional. The name of a PNG file that you put in ./data/
FDROID_REPO_ICON=

# --- Signing key ------------------------------------------------------------
# These two values are used ONE TIME, when the key is made on the first start.
# A change after that start has no effect.
FDROID_KEY_ALIAS=myrepo
FDROID_KEY_DNAME=CN=apps.example.com, OU=F-Droid, O=Example Org, C=US

# --- Behaviour --------------------------------------------------------------
# Keep this many recent versions in the main repository. The older versions
# move to an archive. 0 keeps all the versions in the main repository.
FDROID_ARCHIVE_OLDER=0

# How often to look for new APK files, in seconds. 0 runs one time and stops.
FDROID_SCAN_INTERVAL=60

# Optional. Other addresses that hold a copy of this repository.
# Give a list with commas between the items.
FDROID_MIRRORS=

TZ=UTC
