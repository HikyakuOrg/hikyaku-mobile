# ===========================================================================
#  F-Droid repository configuration
#  Copy this file to ".env", fill it in, then run: docker compose up -d
#
#  This runs the indexer only. The repository is served publicly straight
#  from the S3-compatible bucket below (a Cloudflare Worker can sit in front
#  of it for a custom domain and caching - see fdroid/worker/). There is no
#  local web server. Use `docker compose up -d` to test locally before a
#  push; the CI workflow runs the same container in one-shot mode
#  (FDROID_SCAN_INTERVAL=0) on every push to main.
# ===========================================================================

# The public address users add to their F-Droid client, with no path at the
# end. This is your Worker's custom domain if you have one, otherwise the
# bucket's own public URL. The repository becomes <FDROID_BASE_URL>/fdroid/repo
#   Cloudflare Worker in front of the bucket : https://apps.example.com
#   Bucket's own public URL                  : https://my-bucket.s3.eu-west-1.example.com
FDROID_BASE_URL=https://apps.example.com

# --- S3-compatible bucket ----------------------------------------------------
# Give a bucket name to send the repository to S3 after each index.
# The files go to <bucket>/fdroid/repo/
# Caution: this is a mirror operation. It removes the files in the bucket
# that are not in data/repo/.
FDROID_S3_BUCKET=

# For AWS S3 in the us-east-1 region, these two values are sufficient.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# For a different AWS region, or for MinIO, Cloudflare R2, Backblaze B2 or
# Wasabi, make the file "data/rclone.conf" and put the section name here.
# Section 10 of FDROID.md gives an example.
FDROID_RCLONE_REMOTE=

# --- Pull from a staging prefix (optional) -----------------------------------
# The CI workflow now builds the APK and copies it into data/repo/ directly
# in the same job, so it does not use this. Set a prefix here only if you
# also want the indexer to pick up APK files dropped into the bucket by some
# other process. An empty value turns the pull off. This step only copies; it
# never deletes a local file.
FDROID_S3_PULL_PREFIX=

# --- Repository details -----------------------------------------------------
FDROID_REPO_NAME=My F-Droid Repo
FDROID_REPO_DESCRIPTION=Internal Android apps for my organisation.

# Optional. The name of a PNG file that you put in ./data/
FDROID_REPO_ICON=

# --- Signing key ------------------------------------------------------------
# These two values are used ONE TIME, when the key is made on the first start.
# A change after that start has no effect.
FDROID_KEY_ALIAS=myrepo
FDROID_KEY_DNAME=CN=apps.example.com, OU=F-Droid, O=Example Org, C=US

# --- Behaviour --------------------------------------------------------------
# Keep this many recent versions in the main repository. The older versions
# move to an archive. 0 keeps all the versions in the main repository.
FDROID_ARCHIVE_OLDER=0

# New APK files in data/repo/ are picked up instantly, via inotify. This
# value only sets how often to check the S3 pull prefix above (S3 has no
# inotify equivalent), in seconds. 0 runs one time and stops - no watching.
FDROID_SCAN_INTERVAL=60

# Optional. Other addresses that hold a copy of this repository. If
# FDROID_BASE_URL above is your Worker's custom domain, list the bucket's own
# public URL here as a fallback mirror. Give a list with commas between the
# items.
FDROID_MIRRORS=

TZ=UTC
